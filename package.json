{
  "name": "itop-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "vite build --base /itop-website/ && node scripts/prepare-pages-build.mjs",
    "test:pages": "node --test tests/pages-build.test.mjs tests/site-meta.test.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:enquiries": "node --test tests/enquiry-messages.test.mjs tests/wholesale-draft.test.mjs tests/repair-catalogue.test.mjs tests/wholesale-browsing.test.mjs tests/wholesale-photos.test.mjs tests/buy-sell-message.test.mjs tests/iphone-quotes.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}

